# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL — use Render/Neon/Supabase connection string in production)
DATABASE_URL=postgres://user:password@localhost:5432/asm_erp

# JWT
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Email (for OTP / password reset / new-device alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=flyrd2009@gmail.com
SMTP_PASS=kdzzisxwsfuervhp
SMTP_FROM="ASM Polytechnic ERP <no-reply@asmp.ac.in>"

# WhatsApp (delivers mobile OTPs for login / password reset) — optional.
# Free, open-source, self-hosted via Baileys: no paid API. Set to true, start
# the backend, and scan the QR printed in the terminal with the sender's
# WhatsApp (Settings > Linked devices). Use a DEDICATED number: Baileys is an
# unofficial client, which WhatsApp's terms don't permit, so the number can
# be restricted. Email OTP and password login work regardless.
WHATSAPP_ENABLED=true
# Used when a stored number has no country code (default India: 91)
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Security defaults (overridable per-role in security_settings table)
DEFAULT_MAX_FAILED_ATTEMPTS=5
DEFAULT_LOCKOUT_MINUTES=15
DEFAULT_SESSION_TIMEOUT_MINUTES=20
FORCE_PASSWORD_RESET_ON_UNLOCK=true

# Initial admin seed (used only by seed:admin script)
SEED_ADMIN_EMAIL=admin@asmp.ac.in
SEED_ADMIN_PASSWORD=Rakshu@290709
